# Supabase authentication (admin dashboard login)
# Create free account at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe payment processing
# Get keys from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Set to 'false' to disable payments and allow bookings without payment
NEXT_PUBLIC_PAYMENTS_ENABLED=true

# Optional: Deposit amount in cents (e.g., 5000 = $50.00)
# Leave empty or set to 0 for full payment at time of booking
NEXT_PUBLIC_DEPOSIT_CENTS=0
